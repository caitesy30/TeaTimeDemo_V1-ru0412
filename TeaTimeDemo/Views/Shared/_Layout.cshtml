@using TeaTimeDemo.Resources
@using Microsoft.AspNetCore.Identity
@using TeaTimeDemo.Models

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

<!DOCTYPE html>
<html lang="zh-TW">
<head class="no-print">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - 居希恩共享</title>

    <!-- 樣式（保留你的設定） -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TeaTimeDemo.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons-1.11.3/font/bootstrap-icons.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/build/toastr.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/DataTables/datatables.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/package/dist/sweetalert2.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/select2/select2.css" asp-append-version="true" />

    <!-- 建議加速：對 LINE CDN 預連線 -->
    <link rel="preconnect" href="https://static.line-scdn.net">

    <style>
        #functionWindow {
            width: 150px;
            height: auto;
            cursor: move;
            z-index: 1050;
        }

        #mainEditor {
            margin-bottom: 20px;
        }

        #functionWindow button {
            width: 100%;
        }

        .goog-te-gadget {
            color: transparent;
        }

            .goog-te-gadget .goog-te-menu-value span {
                color: #000;
            }
    </style>

    <!-- Google Translate（維持你的動態載入策略） -->
    <script type="text/javascript">
        function googleTranslateElementInit() {
            new google.translate.TranslateElement({
                pageLanguage: 'zh-TW',
                includedLanguages: 'en,zh,th',
                layout: google.translate.TranslateElement.InlineLayout.SIMPLE
            }, 'google_translate_element');
        }
        (async function () {
            try {
                await fetch('https://translate.google.com/translate_a/element.js', { method: 'HEAD', mode: 'no-cors' });
                let script = document.createElement('script');
                script.type = 'text/javascript';
                script.src = 'https://translate.google.com/translate_a/element.js?cb=googleTranslateElementInit';
                document.head.appendChild(script);
            } catch (error) {
                console.warn("偵測到無法連線到 Google Translate，已略過外部翻譯資源。");
            }
        })();
    </script>

    @await RenderSectionAsync("Styles", required: false)
</head>

<body>
    <header class="no-print">
        <!-- ====== 導覽列（保留你的內容） ====== -->
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">點數管理</a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @* 內容管理下拉（保留你的原樣） *@
                        @if (User.IsInRole(SD.Role_Admin) || User.IsInRole(SD.Role_Manager) || User.IsInRole(SD.Role_Customer))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-dark" data-bs-toggle="dropdown" href="#" role="button"
                                   aria-haspopup="true" aria-expanded="false" data-i18n="內容管理">內容管理</a>
                                <div class="dropdown-menu">
                                    <a class="dropdown-item text-dark" asp-area="Customer" asp-controller="Wallet" asp-action="Index">
                                        <i class="bi bi-wallet2 me-2"></i>我的錢包
                                    </a>
                                    <a class="dropdown-item text-dark" asp-area="Customer" asp-controller="PointLog" asp-action="Index">
                                        <i class="bi bi-journal-text me-2"></i>點數記錄
                                    </a>
                                    <a class="dropdown-item text-dark" asp-area="Customer" asp-controller="Store" asp-action="Blueprint">
                                        <i class="bi bi-diagram-3 me-2"></i>商城藍圖
                                    </a>
                                    <a class="dropdown-item text-dark" asp-area="Customer" asp-controller="Store" asp-action="Index">
                                        <i class="bi bi-shop-window me-2"></i>商城首頁
                                    </a>
                                    <a class="dropdown-item text-dark" asp-area="Customer" asp-controller="Seller" asp-action="ProductCreate">
                                        <i class="bi bi-box-seam me-2"></i>上架商品
                                    </a>

                                    @if (User.IsInRole(SD.Role_Admin))
                                    {
                                        <a class="dropdown-item text-dark" asp-area="Admin" asp-controller="User" asp-action="Index" data-i18n="使用者管理">使用者管理</a>
                                        <div class="dropdown-divider"></div>
                                        <a class="dropdown-item text-danger" asp-area="Admin" asp-controller="CurrencyType" asp-action="Index">
                                            <i class="bi bi-currency-exchange"></i> 幣種/點數管理
                                        </a>
                                        <a class="dropdown-item text-dark" asp-area="Admin" asp-controller="CurrencyAudit" asp-action="Index">
                                            <i class="bi bi-clipboard2-data me-2"></i> 幣種對帳
                                        </a>
                                        <a class="dropdown-item text-dark" asp-area="Customer" asp-controller="PointLog" asp-action="All">
                                            查看全部紀錄（管理）
                                        </a>
                                        <a class="dropdown-item text-dark" asp-area="Customer" asp-controller="PendingCoin" asp-action="Index">
                                            <i class="bi bi-hourglass-split me-2"></i>待領幣管理
                                        </a>
                                        <div class="dropdown-divider"></div>
                                        <a class="dropdown-item" asp-area="Identity" asp-page="/Account/Register" data-i18n="建立使用者">建立使用者</a>
                                    }
                                </div>
                            </li>
                        }
                    </ul>

                    <ul class="navbar-nav">
                        <li class="nav-item dropdown" style="display:none">
                            <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown" data-bs-toggle="dropdown" role="button"
                               aria-haspopup="true" aria-expanded="false" data-toggle="dropdown">
                                <i class="bi bi-globe-americas"></i>
                                <span id="current-language" data-i18n="語言切換"> </span>
                            </a>
                            <div class="dropdown-menu">
                                <a class="dropdown-item language-option" data-lang="en" asp-controller="LangBase" asp-action="ChangeLanguage" asp-route-lang="en-us">English</a>
                                <a class="dropdown-item language-option" data-lang="zh" asp-controller="LangBase" asp-action="ChangeLanguage" asp-route-lang="ch-tw">繁體中文</a>
                                <a class="dropdown-item language-option" data-lang="th" asp-controller="LangBase" asp-action="ChangeLanguage" asp-route-lang="th-th">ไทย</a>
                            </div>
                        </li>
                        <li class="nav-item">
                            <div id="google_translate_element" style="margin-top:8px; margin-left:10px;"></div>
                        </li>
                    </ul>

                    <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
                        @if (SignInManager.IsSignedIn(User))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-dark" href="#" id="userDropdown" role="button"
                                   data-bs-toggle="dropdown" aria-expanded="false">
                                    @UserManager.GetUserName(User)
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                                    <li><a class="dropdown-item" asp-area="Identity" asp-page="/Account/Manage/ChangePassword">更改密碼</a></li>
                                    <li><a class="dropdown-item" asp-area="Identity" asp-page="/Account/Manage/Index">帳戶設定</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form method="post" asp-area="Identity" asp-page="/Account/Logout"
                                              asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })"
                                              id="logoutForm" class="d-inline">
                                            <button type="submit" class="dropdown-item">登出</button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Login">登入</a></li>
                            <li class="nav-item"><a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Register">註冊</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- LIFF 自動填值（隱藏欄位，保留你的表單互通） -->
    <input type="hidden" id="lineUserId" name="lineUserId" />
    <input type="hidden" id="lineDisplayName" name="lineDisplayName" />
    <input type="hidden" id="linePictureUrl" name="linePictureUrl" />

    <!-- 可顯示 LINE 大頭貼區塊（預設隱藏，僅展示）-->
    <div id="lineUserSection" class="text-center mb-4" style="display:none;">
        <img id="linePictureImg" src="" alt="LINE頭像" width="64" height="64"
             class="rounded-circle mb-2" style="object-fit:cover;border:2px solid #6cf;" />
        <div id="helloLineUser" class="mb-2" style="font-weight:bold;font-size:1.15rem;color:#1a936f;"></div>
    </div>

    <div class="container">
        <main role="main" class="pb-3">
            <partial name="_Notification" />
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted no-print">
        <div class="container">
            &copy; 2025 - GCN-Demo <i class="bi bi-1-circle"></i><i class="bi bi-check2-square"></i> -
            <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <!-- ======= JS（保留你的載入） ======= -->
    <script src="~/lib/jquery/dist/jquery.min.js" asp-append-version="true"></script>
    <script src="~/lib/popper/popper.min.js" asp-append-version="true"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/lib/DataTables/datatables.min.js" asp-append-version="true"></script>
    <script src="~/lib/package/dist/sweetalert2.min.js" asp-append-version="true"></script>
    <script src="~/lib/build/toastr.min.js" asp-append-version="true"></script>
    <script src="~/js/querySelection.js" asp-append-version="true"></script>
    <script src="~/js/auth/LogoutUI.js" asp-append-version="true"></script>

    <!-- ✅ LIFF 輔助：不主動 login；僅在 LINE 內展示資料 -->
    <script>
        // ====== Class 1：全域登出防護（noop，但提供旗標給其他腳本參考）======
        class LogoutGuard {
            static NO_AUTO_LOGIN = new URLSearchParams(location.search).get('nologin') === '1';
            static mark() { window.NO_AUTO_LOGIN = this.NO_AUTO_LOGIN; }
        }
        LogoutGuard.mark();

        // ====== Class 2：LIFF 載入與 Profile 展示（不自動登入）======
        class LiffBoot {
            static IN_LINE_APP = /Line/i.test(navigator.userAgent);
            static _sdkLoaded = false;
            static _initedId = null;

            static async ensure(liffId) {
                if (!this.IN_LINE_APP) return null;                 // 不在 LINE 內就不載
                if (!(window).liff) {                               // 動態載 SDK
                    await this._loadSdk();
                }
                if (!this._initedId || this._initedId !== liffId) {
                    await (window).liff.init({ liffId });
                    this._initedId = liffId;
                }
                return (window).liff;
            }

            static _loadSdk() {
                if (this._sdkLoaded) return Promise.resolve();
                return new Promise((resolve, reject) => {
                    const url = 'https://static.line-scdn.net/liff/edge/2.27.1/sdk.js';
                    const s = document.createElement('script');
                    s.src = url; s.async = true;
                    s.onload = () => { this._sdkLoaded = true; resolve(); };
                    s.onerror = () => reject(new Error('LIFF SDK 載入失敗'));
                    document.head.appendChild(s);
                });
            }

            static async initProfileIfAvailable(liffId = "2007537903-r3pknwbl") {
                if (!this.IN_LINE_APP) return;
                try {
                    const liff = await this.ensure(liffId);
                    if (!liff) return;
                    if (!liff.isLoggedIn()) return;                 // ❗不自動 login
                    const profile = await liff.getProfile();

                    // 寫入隱藏欄位
                    const $id = document.getElementById('lineUserId');
                    const $nm = document.getElementById('lineDisplayName');
                    const $pic = document.getElementById('linePictureUrl');
                    if ($id)  $id.value  = profile.userId;
                    if ($nm)  $nm.value  = profile.displayName;
                    if ($pic) $pic.value = profile.pictureUrl || '';

                    // 顯示歡迎與頭像（僅展示）
                    const sec = document.getElementById('lineUserSection');
                    const hello = document.getElementById('helloLineUser');
                    const img = document.getElementById('linePictureImg');
                    if (hello) hello.innerText = `歡迎回來，${profile.displayName}！`;
                    if (img && profile.pictureUrl) img.src = profile.pictureUrl;
                    if (sec) sec.style.display = '';
                } catch (e) {
                    console.warn('LIFF 初始化或取用戶資料失敗：', e?.message || e);
                }
            }
        }

        // ====== Class 3：分享工具（LINE 內優先，用不到也可共用）======
        class LineShareUtil {
            static async share({ text = '', url = '', liffId = "2007537903-r3pknwbl" } = {}) {
                try {
                    const liff = await LiffBoot.ensure(liffId);
                    const payload = [text, url].filter(Boolean).join('\n');
                    if (liff) {
                        if (!liff.isLoggedIn()) {
                            // 只有在 LINE 內才會走到這；必要時才登入
                            await liff.login();
                            return;
                        }
                        if (liff.isApiAvailable('shareTargetPicker')) {
                            await liff.shareTargetPicker([{ type: 'text', text: payload }]);
                        } else {
                            await liff.sendMessages([{ type: 'text', text: payload }]);
                        }
                        return true;
                    }
                } catch (e) {
                    console.warn('LIFF 分享失敗，fallback 走 Web：', e?.message || e);
                }
                // Web fallback
                const msg = [text, url || location.href].filter(Boolean).join(' ');
                const lineUrl = 'https://line.me/R/msg/text/?' + encodeURIComponent(msg);
                if (navigator.share) {
                    try { await navigator.share({ title: document.title, text, url }); }
                    catch { window.open(lineUrl, '_blank'); }
                } else {
                    window.open(lineUrl, '_blank');
                }
                return false;
            }
        }
        window.shareToLine = (opts) => LineShareUtil.share(opts);

        // ====== Class 4：領幣 token 保留（避免轉址遺失）======
        class ClaimTokenHelper {
            static KEY = 'claimToken';
            static captureFromUrl() {
                const p = new URLSearchParams(location.search);
                const token = p.get('token');
                const mode = p.get('mode');
                if (mode === 'claim' && token) {
                    try { localStorage.setItem(this.KEY, token); } catch { }
                }
            }
            static getSaved() {
                try { return localStorage.getItem(this.KEY) || ''; } catch { return ''; }
            }
            static clear() {
                try { localStorage.removeItem(this.KEY); } catch { }
            }
        }
        ClaimTokenHelper.captureFromUrl();

        // ====== Class 5：全域 Debug bar（顯示 mode/token）======
        class DebugBar {
            static show() {
                const p = new URLSearchParams(location.search);
                const mode = p.get('mode');
                const token = p.get('token');
                const d = document.getElementById('globalDebugInfo');
                if (!d) return;
                if (mode || token) {
                    d.style.display = 'block';
                    d.innerHTML = `mode: <strong>${mode || '無'}</strong> | token: <strong>${token || '無'}</strong>`;
                }
            }
        }

        // ====== 啟動：僅展示 Profile，不自動登入。Debug 顯示 ======
        document.addEventListener('DOMContentLoaded', () => {
            LiffBoot.initProfileIfAvailable(); // 展示用，不login
            DebugBar.show();
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)

    <!-- 全域 debug 浮窗 -->
    <div id="globalDebugInfo"
         style="position:fixed;bottom:0;right:0;z-index:9999;background:#eef;padding:5px;border:1px dashed #99f;display:none;font-size:0.9rem;">
    </div>
</body>
</html>
