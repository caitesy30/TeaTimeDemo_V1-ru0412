 <!-- ✅ 只在這裡載一次 LIFF SDK -->
    @* <script src="https://static.line-scdn.net/liff/edge/2.27.1/sdk.js" id="liff-sdk"></script> *@
  <script>
    // =======================
  // LIFF 全域保護與初始化（修正版）
  // 重點：偵測是否在 LINE App，而不是檢查 host=liff.line.me
  // =======================
  const IN_LINE_APP = /Line/i.test(navigator.userAgent);

  function describeError(e) {
    if (!e) return '未知錯誤';
    if (e.message) return e.message;
    if (e.type && e.target && e.target.src) return `SDK載入失敗：${e.type} ${e.target.src}`;
    return String(e);
  }

  const LIFF_SDK_CANDIDATES = [
    'https://static.line-scdn.net/liff/edge/2.27.1/sdk.js',
    'https://static.line-scdn.net/liff/edge/2/sdk.js'
  ];

  function loadScript(src, timeoutMs = 8000) {
    return new Promise((resolve, reject) => {
      const el = document.createElement('script');
      let done = false;
      const timer = setTimeout(() => {
        if (done) return;
        done = true; el.remove();
        reject(new Error(`SDK載入逾時：${src}`));
      }, timeoutMs);
      el.async = true;
      el.src = src;
      el.onload = () => { if (done) return; done = true; clearTimeout(timer); resolve(); };
      el.onerror = (ev) => { if (done) return; done = true; clearTimeout(timer); reject(new Error(describeError(ev))); };
      document.head.appendChild(el);
    });
  }

  // ---- 全域 ensureLiff：在 LINE 內回傳 liff，LINE 外回傳 null（不再是 undefined）----
  window.ensureLiff = (() => {
    if (!IN_LINE_APP) {
      // 不在 LINE App：回傳 null，避免 "is not a function"
      return async () => null;
    }
    let initedId = null;
    return async (liffId) => {
      if (typeof window.liff === 'undefined') {
        let lastErr;
        for (const url of LIFF_SDK_CANDIDATES) {
          try { await loadScript(url); break; }
          catch (e) { lastErr = e; console.warn(e?.message || e); }
        }
        if (typeof window.liff === 'undefined') {
          throw lastErr || new Error('LIFF SDK 無法載入，可能被網路或 CSP 擋下。');
        }
      }
      if (!initedId || initedId !== liffId) {
        await window.liff.init({ liffId });
        initedId = liffId;
      }
      return window.liff;
    };
  })();

  // 是否在 LINE App WebView（供其它程式用）
  window.isInLineApp = () => IN_LINE_APP;

  // =======================
  // 預設：若在 LINE 內、且已登入 → 取 profile 自動填欄位
  // 不自動 login（避免無謂的重導）
  // =======================
  (async function () {
    const DEFAULT_LIFF_ID = "2007537903-r3pknwbl";
    if (!IN_LINE_APP) return;

    try {
      const liff = await ensureLiff(DEFAULT_LIFF_ID);
      if (!liff) return;              // 非 LINE 內保險
      if (!liff.isLoggedIn()) return; // 不自動 login

      const profile = await liff.getProfile();
      const $id   = document.getElementById('lineUserId');
      const $name = document.getElementById('lineDisplayName');
      const $pic  = document.getElementById('linePictureUrl');

      if ($id)   $id.value   = profile.userId;
      if ($name) $name.value = profile.displayName;
      if ($pic)  $pic.value  = profile.pictureUrl || '';

      const hello = document.getElementById('helloLineUser');
      if (hello) hello.innerText = `歡迎回來，${profile.displayName}！`;
      if (profile.pictureUrl) {
        const img = document.getElementById('linePictureImg');
        if (img) img.src = profile.pictureUrl;
      }
      const sec = document.getElementById('lineUserSection');
      if (sec) sec.style.display = '';
    } catch (err) {
      console.warn('LIFF 初始化或取用戶資料失敗：', describeError(err));
    }
  })();

  // =======================
  // 共用：分享到 LINE（在 LINE 內用 LIFF；LINE 外自動退回 Web Share / 連結）
  // 呼叫方式：shareToLine({ text: '...', url: '...' })
  // =======================
  (function () {
    function webFallbackShare(text, url) {
      const msg = [text, url || location.href].filter(Boolean).join(' ');
      const lineUrl = 'https://line.me/R/msg/text/?' + encodeURIComponent(msg);
      if (navigator.share) {
        navigator.share({ title: document.title, text: text || '', url: url || location.href })
          .catch(() => window.open(lineUrl, '_blank'));
      } else {
        window.open(lineUrl, '_blank');
      }
    }

    window.shareToLine = async function ({ liffId = "2007537903-r3pknwbl", text = '', url = '' } = {}) {
      try {
        const liff = await ensureLiff(liffId); // 可能回 null（LINE 外）
        if (liff) {
          if (!liff.isLoggedIn()) {
            // 只在 LINE 內才會執行到這裡 → 可選：需要時才登入
            await liff.login(); 
            return; // 登入後會重進頁面
          }
          const payloadText = [text, url].filter(Boolean).join('\n');

          if (liff.isApiAvailable('shareTargetPicker')) {
            await liff.shareTargetPicker([{ type: 'text', text: payloadText }]);
          } else {
            await liff.sendMessages([{ type: 'text', text: payloadText }]);
          }
          return true;
        }
      } catch (e) {
        console.warn('LIFF 分享失敗，改用 Web 分享：', describeError(e));
      }
      webFallbackShare(text, url);
      return false;
    };
  })();

  // 全域除錯浮窗（帶 mode / token 時顯示）
  (function () {
    const params = new URLSearchParams(location.search);
    const mode = params.get('mode');
    const token = params.get('token');
    if (mode || token) {
      const d = document.getElementById('globalDebugInfo');
      if (d) {
        d.style.display = 'block';
        d.innerHTML = `mode: <strong>${mode || '無'}</strong> | token: <strong>${token || '無'}</strong>`;
      }
    }
  })();
</script>


    @await RenderSectionAsync("Scripts", required: false)

    <!-- 全局除錯顯示區塊 -->
    <div id="globalDebugInfo" style="position:fixed;bottom:0;right:0;z-index:9999;background:#eef;padding:5px;border:1px dashed #99f;display:none;font-size:0.9rem;"></div>
</body>
</html>


