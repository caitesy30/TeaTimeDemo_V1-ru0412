@page
@model RegisterConfirmationModel
@{
    ViewData["Title"] = "註冊確認";
}

<!-- 根容器：資料交給 JS，HTML 由 JS 動態生成 -->
<div id="confirm-root"
     data-has-link="@Model.DisplayConfirmAccountLink"
     data-confirm-url="@Model.EmailConfirmationUrl">
</div>

<noscript>
    <div class="container my-4">
        <div class="alert alert-info">
            您的瀏覽器未啟用 JavaScript。請啟用後重新整理，或依信件內的驗證連結完成帳號確認。
        </div>
        @if (Model.DisplayConfirmAccountLink)
        {
            <p class="mb-0">
                測試環境直接驗證：<a href="@Model.EmailConfirmationUrl">點我完成驗證</a>
            </p>
        }
        else
        {
            <p class="mb-0">請至您的信箱收信，點擊驗證連結完成註冊。</p>
        }
    </div>
</noscript>

@section Styles{
    <style>
        .rc-wrap{
            max-width:720px;margin:32px auto;padding:0 16px;
            font-family: system-ui, -apple-system, "Segoe UI", "Microsoft JhengHei", Arial, sans-serif;
        }
        .rc-card{
            border:1px solid #e5e7eb;border-radius:16px;background:#fff;
            box-shadow:0 6px 24px rgba(0,0,0,.06);overflow:hidden;
        }
        .rc-head{
            background:linear-gradient(135deg,#22c55e,#16a34a);
            color:#fff;padding:18px 20px;display:flex;align-items:center;gap:12px;
        }
        .rc-head .rc-emoji{font-size:28px;line-height:1}
        .rc-title{margin:0;font-size:20px;font-weight:700}
        .rc-body{padding:20px}
        .rc-p{margin:0 0 10px 0;color:#374151}
        .rc-cta{display:flex;flex-wrap:wrap;gap:10px;margin-top:12px}
        .rc-btn{
            border:0;border-radius:12px;padding:10px 14px;cursor:pointer;
            font-weight:700;transition:.2s;display:inline-flex;align-items:center;gap:8px;
        }
        .rc-btn-primary{background:#16a34a;color:#fff;}
        .rc-btn-primary:hover{filter:brightness(.95)}
        .rc-btn-ghost{background:#f3f4f6;color:#111827;}
        .rc-btn-ghost:hover{background:#e5e7eb}
        .rc-note{background:#f9fafb;border:1px dashed #e5e7eb;border-radius:12px;padding:12px;margin-top:16px;color:#4b5563}
        .rc-footer{padding:14px 20px;background:#fafafa;color:#6b7280;border-top:1px solid #eee;font-size:13px}
        .rc-link{color:#2563eb;text-decoration:none}
        .rc-link:hover{text-decoration:underline}
        .rc-badge{
            display:inline-block;border-radius:999px;padding:4px 10px;font-size:12px;font-weight:700;color:#065f46;background:#d1fae5;margin-left:auto;
        }
        /* 行動裝置微調 */
        @@media (max-width:480px){
            .rc-title{font-size:18px}
        }
    </style>
}

@section Scripts{
<script>
/* 以 Class + static 方式，所有 HTML 動態產生 */
class RegisterConfirmView {
    static boot() {
        const root = document.getElementById('confirm-root');
        if (!root) return;

        const hasLink = (root.dataset.hasLink || '').toString().toLowerCase() === 'true';
        const url = root.dataset.confirmUrl || '';

        const html = hasLink
            ? this.#tplWithLink(url)
            : this.#tplNoLink();

        root.innerHTML = html;

        // 綁定事件
        if (hasLink) {
            const btnCopy = document.getElementById('rc-copy');
            if (btnCopy) btnCopy.addEventListener('click', () => this.#copy(url));

            const btnGo  = document.getElementById('rc-go');
            if (btnGo) btnGo.addEventListener('click', () => this.#open(url));
        }

        // 信箱捷徑
        const map = {
            'rc-gmail': 'https://mail.google.com/',
            'rc-yahoo': 'https://mail.yahoo.com/',
            'rc-outlook': 'https://outlook.live.com/mail/'
        };
        Object.keys(map).forEach(id=>{
            const el = document.getElementById(id);
            if (el) el.addEventListener('click', ()=> window.open(map[id], '_blank'));
        });

        // 回首頁
        const home = document.getElementById('rc-home');
        if (home) home.addEventListener('click', ()=> location.href = '/');

        // 重新發送（若你之後提供 API，可在此呼叫）
        const resend = document.getElementById('rc-resend');
        if (resend) resend.addEventListener('click', ()=>{
            alert('已請您稍候，系統將重新發送驗證信（示意）。');
            // TODO: fetch('/Identity/Account/ResendEmailConfirmation', { method: 'POST', ... })
        });
    }

    static #tplWithLink(url){
        const safeUrl = this.#escape(url);
        return `
        <div class="rc-wrap">
          <div class="rc-card">
            <div class="rc-head">
              <div class="rc-emoji">📬</div>
              <h1 class="rc-title">註冊確認</h1>
              <span class="rc-badge">測試環境</span>
            </div>
            <div class="rc-body">
              <p class="rc-p">目前尚未設定真實的寄信服務。正式環境會把「驗證連結」寄到您的信箱；為方便測試，您可以直接點擊下方按鈕完成驗證。</p>
              <div class="rc-cta">
                <button id="rc-go"   class="rc-btn rc-btn-primary">✅ 立刻完成驗證</button>
                <button id="rc-copy" class="rc-btn rc-btn-ghost">📋 複製驗證連結</button>
              </div>
              <div class="rc-note">
                <div style="font-weight:700;margin-bottom:6px;">驗證連結（開發測試用）</div>
                <div style="word-break:break-all;"><a class="rc-link" href="${safeUrl}">${safeUrl}</a></div>
              </div>

              <div class="rc-note" style="margin-top:16px;">
                <div style="font-weight:700;margin-bottom:6px;">沒收到信嗎？（正式環境）</div>
                <ul style="padding-left:18px;margin:0;">
                  <li>請檢查垃圾信匣或促銷匣</li>
                  <li>將我們的寄件位址加入通訊錄，再嘗試 <a href="javascript:void(0)" id="rc-resend" class="rc-link">重新發送驗證信</a></li>
                </ul>
                <div class="rc-cta" style="margin-top:10px;">
                  <button id="rc-gmail"  class="rc-btn rc-btn-ghost">Gmail</button>
                  <button id="rc-yahoo"  class="rc-btn rc-btn-ghost">Yahoo</button>
                  <button id="rc-outlook" class="rc-btn rc-btn-ghost">Outlook</button>
                </div>
              </div>
            </div>
            <div class="rc-footer">
              若您已完成驗證，<a class="rc-link" href="/Identity/Account/Login">點此登入</a>；或前往 <a id="rc-home" class="rc-link" href="javascript:void(0)">首頁</a>。
            </div>
          </div>
        </div>`;
    }

    static #tplNoLink(){
        return `
        <div class="rc-wrap">
          <div class="rc-card">
            <div class="rc-head">
              <div class="rc-emoji">✉️</div>
              <h1 class="rc-title">註冊確認</h1>
            </div>
            <div class="rc-body">
              <p class="rc-p">我們已寄出一封「帳號驗證信」到您的信箱，請開啟郵件並點擊其中的驗證連結完成註冊。</p>
              <div class="rc-note">
                <div style="font-weight:700;margin-bottom:6px;">小提醒</div>
                <ul style="padding-left:18px;margin:0;">
                  <li>若幾分鐘後仍未收到，請先檢查垃圾信匣</li>
                  <li>將系統寄件位址加入通訊錄，避免被誤判</li>
                  <li>仍有問題？可回到登入頁點選「重新發送確認信」</li>
                </ul>
              </div>
              <div class="rc-cta">
                <button id="rc-gmail"  class="rc-btn rc-btn-ghost">開 Gmail</button>
                <button id="rc-yahoo"  class="rc-btn rc-btn-ghost">開 Yahoo</button>
                <button id="rc-outlook" class="rc-btn rc-btn-ghost">開 Outlook</button>
              </div>
            </div>
            <div class="rc-footer">
              完成驗證後即可 <a class="rc-link" href="/Identity/Account/Login">登入</a>，也可以回 <a id="rc-home" class="rc-link" href="javascript:void(0)">首頁</a> 逛逛。
            </div>
          </div>
        </div>`;
    }

    static async #copy(text){
        try{
            await navigator.clipboard.writeText(text||'');
            this.#toast('已複製驗證連結！');
        }catch{
            this.#toast('複製失敗，請手動選取連結。', true);
        }
    }
    static #open(url){
        if(!url){ this.#toast('目前沒有可用的驗證連結。', true); return; }
        window.location.href = url;
    }
    static #toast(msg, danger=false){
        const el = document.createElement('div');
        el.textContent = msg;
        el.style.cssText = `
            position:fixed;left:50%;bottom:20px;transform:translateX(-50%);
            background:${danger?'#fee2e2':'#ecfdf5'};color:${danger?'#b91c1c':'#065f46'};
            border:1px solid ${danger?'#fecaca':'#a7f3d0'};
            padding:8px 12px;border-radius:12px;font-weight:700;z-index:9999;
        `;
        document.body.appendChild(el);
        setTimeout(()=>el.remove(), 2000);
    }
    static #escape(s){ return (s||'').replace(/[&<>"']/g, m=>({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[m])); }
}
        document.addEventListener('DOMContentLoaded', ()=> RegisterConfirmView.boot());
       </script>
       }
