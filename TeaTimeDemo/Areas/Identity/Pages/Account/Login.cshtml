@page
@model LoginModel
@using System
@{
    ViewData["Title"] = "登入";

    // 1) 決定回跳網址
    var returnUrl = !string.IsNullOrWhiteSpace(Model.ReturnUrl)
        ? Model.ReturnUrl
        : Request.Query["returnUrl"].ToString();

    if (string.IsNullOrWhiteSpace(returnUrl))
    {
        returnUrl = "/Customer/Wallet/Index";
    }

    // 2) 第三方 LINE 登入入口（建議用你專案的 B 入口，會保留 returnUrl）
    var lineLoginUrl = $"/Customer/LiffAuthEntry/Login?returnUrl={Uri.EscapeDataString(returnUrl)}";

    // 若想用 Identity 內建 ExternalLogin（擇一），請改用下行：
    // var lineLoginUrl = $"/Identity/Account/ExternalLogin?handler=Challenge&provider=Line&returnUrl={Uri.EscapeDataString(returnUrl)}";
}

<div class="container my-5" style="max-width:720px">
    <h1 class="mb-4 text-center">登入</h1>

    <div class="row g-4">
        <!-- 左：本地帳號登入 -->
        <div class="col-12 col-md-6">
            <div class="card shadow-sm h-100">
                <div class="card-body p-4">
                    <h5 class="card-title mb-3">以帳號密碼登入</h5>

                    <form id="account" method="post">
                        <input type="hidden" name="ReturnUrl" value="@returnUrl" />

                        <div asp-validation-summary="ModelOnly" class="text-danger mb-2" role="alert"></div>

                        <div class="form-floating mb-3">
                            <input asp-for="Input.Email" class="form-control" autocomplete="username" placeholder="name@example.com" />
                            <label asp-for="Input.Email">Email</label>
                            <span asp-validation-for="Input.Email" class="text-danger"></span>
                        </div>

                        <div class="form-floating mb-3">
                            <input asp-for="Input.Password" class="form-control" autocomplete="current-password" placeholder="password" />
                            <label asp-for="Input.Password">密碼</label>
                            <span asp-validation-for="Input.Password" class="text-danger"></span>
                        </div>

                        <div class="form-check mb-3">
                            <input class="form-check-input" asp-for="Input.RememberMe" />
                            <label class="form-check-label" asp-for="Input.RememberMe">
                                記住我
                            </label>
                        </div>

                        <button id="login-submit" type="submit" class="btn btn-primary w-100">
                            以本地帳號登入
                        </button>

                        <div class="mt-3 small">
                            <p class="mb-1"><a asp-page="./ForgotPassword">忘記密碼？</a></p>
                            <p class="mb-1"><a asp-page="./Register" asp-route-returnUrl="@returnUrl">註冊新帳號</a></p>
                            <p class="mb-0"><a asp-page="./ResendEmailConfirmation">重新發送確認信</a></p>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- 右：LINE 第三方登入 -->
        <div class="col-12 col-md-6">
            <div class="card shadow-sm h-100">
                <div class="card-body p-4 d-flex flex-column">
                    <h5 class="card-title mb-3">使用 LINE 登入</h5>

                    <p class="text-muted small">
                        由 LINE 進行身分驗證，完成後將帶您回到原頁面。
                    </p>

                    <a class="btn btn-success btn-lg w-100 mt-auto" href="@lineLoginUrl">
                        <i class="bi bi-chat-dots me-1"></i> 使用 LINE 登入
                    </a>

                    <div class="text-center text-muted small mt-3">
                        完成授權後將回到：<br />
                        <code class="text-wrap d-inline-block" style="max-width:100%">@returnUrl</code>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
