@page
@using System
@model LoginModel
@{
    ViewData["Title"] = "登入";

    // 優先吃 Model.ReturnUrl，其次讀 querystring；最後預設回錢包首頁
    var returnUrl = !string.IsNullOrWhiteSpace(Model.ReturnUrl)
        ? Model.ReturnUrl
        : Request.Query["returnUrl"].ToString();   // ← 這裡改用 Request（或用 ViewContext.HttpContext.Request）

    if (string.IsNullOrWhiteSpace(returnUrl))
    {
        returnUrl = "/Customer/Wallet/Index";
    }

    var bLoginUrl = $"/Customer/LiffAuthEntry/Login?returnUrl={Uri.EscapeDataString(returnUrl)}";
}

<div class="container my-4" style="max-width:560px">
    <div class="alert alert-info mb-3">
        正在連線 LINE，請稍候…
    </div>

    <!-- 主動引導使用者走 B 入口（會保留 returnUrl/rid） -->
    <a class="btn btn-success w-100" href="@bLoginUrl">
        使用 LINE 登入
    </a>

    <p class="text-muted mt-2 mb-0" style="font-size:13px">
        若未自動導向，請點上方按鈕再試一次。
    </p>

    <details class="mt-3">
        <summary class="text-muted">改用本地帳號登入（除錯/後台用）</summary>
        <div class="mt-3">
            <form id="account" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

                <div class="form-floating mb-3">
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" placeholder="name@example.com" />
                    <label asp-for="Input.Email" class="form-label">Email</label>
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>

                <div class="form-floating mb-3">
                    <input asp-for="Input.Password" class="form-control" autocomplete="current-password" placeholder="password" />
                    <label asp-for="Input.Password" class="form-label">密碼</label>
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>

                <div class="checkbox mb-3">
                    <label asp-for="Input.RememberMe" class="form-label">
                        <input class="form-check-input" asp-for="Input.RememberMe" />
                        @Html.DisplayNameFor(m => m.Input.RememberMe)
                    </label>
                </div>

                <button id="login-submit" type="submit" class="w-100 btn btn-outline-primary">以本地帳號登入</button>

                <div class="mt-3">
                    <p><a asp-page="./ForgotPassword">忘記密碼？</a></p>
                    <p><a asp-page="./Register" asp-route-returnUrl="@returnUrl">註冊新帳號</a></p>
                    <p><a asp-page="./ResendEmailConfirmation">重新發送確認信</a></p>
                </div>
            </form>
        </div>
    </details>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // ✅ 自動嘗試一次真正的 LINE 授權入口（保留 returnUrl/rid）
        window.addEventListener('DOMContentLoaded', function () {
            setTimeout(function () {
                // 用 Html.Raw 避免 & 被變成 &amp; 影響導轉
                location.replace('@Html.Raw(bLoginUrl)');
            }, 300);
        });
    </script>
}
