@model IEnumerable<TeaTimeDemo.Models.CurrencyType>
@{
    ViewData["Title"] = "幣種管理";
}
<h3>幣種管理 <span id="importExportSlot"></span></h3>

<a asp-action="Create" class="btn btn-success mb-2">新增幣種</a>
<input type="text" id="currencySearch" class="form-control mb-2" placeholder="搜尋幣種..." style="max-width: 260px;" />

<div class="table-responsive">
    <table id="currencyTable" class="table table-bordered table-striped align-middle w-100">
        <thead>
            <tr>
                <th>排序</th>
                <th>Icon</th>
                <th>名稱</th>
                <th>發行數量</th>
                <th>說明</th>
                <th>抵押兌換率</th>
                <th>發行日期</th>
                <th>動作</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.OrderBy(x => x.SortOrder))
            {
                <tr>
                    <td>@item.SortOrder</td>
                    <td><img src="@item.IconPath" style="width:40px;height:40px;" /></td>
                    <td>@item.Name</td>
                    <td>@item.TotalIssued</td>
                    <td>@item.Description</td>
                    <td>@item.ExchangeRate:1</td>
                    <td>@item.IssuedAt.ToString("yyyy-MM-dd")</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-success btn-sm">編輯</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm">刪除</a>

                        <!-- 發幣按鈕，帶幣種Id和名稱 -->
                        <button type="button"
                                class="btn btn-warning btn-sm ms-1 send-currency-btn"
                                data-currencyid="@item.Id"
                                data-currencyname="@item.Name">
                            發幣
                        </button>


                    </td>
                </tr>
            }
        </tbody>
    </table>

  

</div>

@section Scripts {
    <link href="~/lib/DataTables/datatables.min.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/currency-manage.css" rel="stylesheet" asp-append-version="true" />
    <script src="~/lib/jquery/dist/jquery.min.js" asp-append-version="true"></script>
    <script src="~/lib/DataTables/datatables.min.js" asp-append-version="true"></script>
    <script src="~/js/currency-manage.js" asp-append-version="true"></script>
}
