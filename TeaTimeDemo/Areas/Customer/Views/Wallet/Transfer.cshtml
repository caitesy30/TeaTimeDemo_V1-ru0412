@model TeaTimeDemo.Models.ViewModels.TransferCoinVM
@{
    ViewData["Title"] = "點數轉讓";
}

<div class="container mt-4" style="max-width:420px">
    <h4 class="mb-3">點數轉讓</h4>
    <div class="text-center mb-3">
        <img src="@Model.IconPath" width="48" /><br />
        <span class="h5">@Model.Name</span><br />
        <span class="text-muted">擁有數量：@Model.Quantity</span>
    </div>
    <form asp-action="Transfer" method="post" id="transferForm">
        <input type="hidden" name="CurrencyTypeId" value="@Model.CurrencyTypeId" />
        <input type="hidden" name="Name" value="@Model.Name" />
        <input type="hidden" name="IconPath" value="@Model.IconPath" />

        <!-- 對象選擇 Tab -->
        <div class="mb-3">
            <label class="form-label">選擇轉讓對象：</label>
            <ul class="nav nav-tabs" id="transferTab" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="tab-member" data-bs-toggle="tab" data-bs-target="#tab-content-member" type="button" role="tab">會員</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="tab-line" data-bs-toggle="tab" data-bs-target="#tab-content-line" type="button" role="tab">LINE 好友</button>
                </li>
            </ul>
            <div class="tab-content pt-3">
                <div class="tab-pane fade show active" id="tab-content-member" role="tabpanel">
                    <select class="form-select" name="TargetUserId" id="TargetUserId">
                        <option value="">請選擇會員</option>
                        @foreach (var u in ViewBag.MemberList as List<SelectListItem>)
                        {
                            <option value="@u.Value">@u.Text</option>
                        }
                    </select>
                </div>
                <div class="tab-pane fade" id="tab-content-line" role="tabpanel">
                    <div class="alert alert-info">
                        點選下方「LINE好友真實分享邀請」或「掃描對方收款QR」按鈕
                    </div>
                    <button type="button" id="shareLineInviteBtn" class="btn btn-success mt-2 w-100">LINE 好友真實分享邀請</button>
                    <button type="button" id="scanQrBtn" class="btn btn-secondary mt-2 w-100">掃描對方收款QR</button>
                    <input type="hidden" id="pendingToken" value="" />

                    <!-- 補上兩個欄位（即使暫時沒用，避免取值 undefined） -->
                    <input type="hidden" id="LineFriendId" name="TargetLineFriendId" value="" />
                    <input type="hidden" id="LineFriendName" name="TargetLineFriendName" value="" />

                </div>
            </div>
        </div>

        <!-- 轉讓數量 -->
        <div class="mb-3">
            <label for="TransferQty" class="form-label">轉讓數量：</label>
            <input type="number" class="form-control" name="TransferQty" id="TransferQty" min="1" max="@Model.Quantity"
                   value="@Model.TransferQty" required />
        </div>

        <!-- 註記 -->
        <div class="mb-3">
            <label for="Note" class="form-label">註記（選填）：</label>
            <input type="text" class="form-control" name="Note" id="Note" maxlength="100" />
        </div>

        <!-- 會員送出按鈕（LINE 好友時隱藏） -->
        <button type="submit" class="btn btn-success w-100" id="submitMemberBtn">送出（內部會員）</button>
    </form>
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger mt-3">@Html.ValidationSummary()</div>
    }
</div>

@section Scripts {
  
    <script>
        (function () {
          const LIFF_ID = "2007537903-r3pknwbl";

          // 切 Tab 顯示 / 隱藏按鈕
          $(function () {
            $('#transferTab button').on('shown.bs.tab', function (e) {
              const id = $(e.target).attr('id');
              const isMember = (id === 'tab-member');
              $('#submitMemberBtn').toggle(isMember);
              $('#shareLineInviteBtn, #scanQrBtn').toggle(!isMember);
            });
            // 預設
            $('#submitMemberBtn').show();
            $('#shareLineInviteBtn, #scanQrBtn').hide();

            // 送出會員轉讓（原樣）
            $('#transferForm').on('submit', function (e) {
              const active = $('#transferTab .nav-link.active').attr('id');
              if (active === 'tab-member' && !$('#TargetUserId').val()) {
                alert('請選擇會員');
                e.preventDefault();
              }
              if (active === 'tab-line') e.preventDefault(); // LINE 好友走分享流程
            });

            // ===== 真實分享：產 Token → 分享 =====
                   $('#shareLineInviteBtn').off('click').on('click', async function (e) {
          e.preventDefault();

          const currencyTypeId = $('[name=CurrencyTypeId]').val();
          const transferQty    = Number($('[name=TransferQty]').val());
          const note           = ($('[name=Note]').val() || '').trim();
          const name           = ($('[name=Name]').val() || '').trim();

          if (!transferQty || transferQty <= 0) { alert('請輸入正確的轉讓數量'); return; }

          try {
            // 1) 先向後端建立 Pending + 預扣，拿 token
            const res = await $.ajax({
              url: '/Customer/Wallet/TransferToLine',
              type: 'POST',
              dataType: 'json',
              data: {
                CurrencyTypeId: currencyTypeId,
                TransferQty: transferQty,
                Note: note,
                Name: name,
                TargetLineFriendId: $('#LineFriendId').val() || '',
                TargetLineFriendName: $('#LineFriendName').val() || ''
              }
            });

            if (!res || !res.success || !res.token) { alert('產生邀請失敗，請稍後重試'); return; }

            // 2) 組 Start URL（走後端 Start→rid→LiffReturn）
            const startUrl =
              `${location.origin}/Customer/Wallet/Start?mode=gift&token=${encodeURIComponent(res.token)}&liffId=${encodeURIComponent(LIFF_ID)}`;

            // 3) 非 LINE App 直接走備援：複製連結 + 開新分頁（不要硬 init LIFF）
            if (!window.isInLineApp()) {
              try { await navigator.clipboard.writeText(startUrl); } catch {}
              alert('已產生邀請連結（目前不在 LINE 內），已幫你複製，請貼給好友。');
              window.open(startUrl, '_blank');
              // 轉結果頁
              location.href = '/Customer/Wallet/TransferResult?msg=' + encodeURIComponent('已預約轉讓，請把連結分享給好友！');
              return;
            }

            // 4) 在 LINE 內 → 初始化 LIFF 後用 shareTargetPicker
            try {
              const liff = await ensureLiff(LIFF_ID);
              if (!liff.isLoggedIn()) { liff.login(); return; }

              const canShare = liff.isApiAvailable('shareTargetPicker');
              if (canShare) {
                const text =
                  `你收到來自【${name || '朋友'}】的點數轉讓邀請！\n` +
                  `數量：${transferQty}\n註記：${note || '（無）'}\n` +
                  `【請點這裡領取】👉 ${startUrl}`;

                const result = await liff.shareTargetPicker([{ type: 'text', text }]);
                // 使用者取消分享時 result 可能是 undefined，這不是錯誤
              } else {
                // 版本或裝置不支援 → 備援
                try { await navigator.clipboard.writeText(startUrl); } catch {}
                alert('目前裝置不支援分享選擇器，連結已複製，請貼給好友。');
                window.location.href = startUrl;
              }
            } catch (err) {
              console.error('LIFF error:', err);
              const msg = (err && (err.message || (err.type ? `SDK載入失敗(${err.type})` : String(err)))) || '初始化失敗';
              alert('LIFF 分享或初始化失敗：' + msg);
              // 再給一次備援
              try { await navigator.clipboard.writeText(startUrl); } catch {}
              window.location.href = startUrl;
            }

            // 5) 結束頁
            location.href = '/Customer/Wallet/TransferResult?msg=' +
              encodeURIComponent('已預約轉讓給 LINE 好友，等對方領取後才會扣點！');

          } catch (xhr) {
            if (xhr && xhr.status === 401) {
              const returnUrl = encodeURIComponent(location.pathname + location.search);
              location.href = `/Customer/LiffAuthEntry/Login?returnUrl=${returnUrl}`;
              return;
            }
            alert('伺服器錯誤，無法產生邀請');
          }
        });

               // === 掃碼 ===
            $('#scanQrBtn').off('click').on('click', async function () {
              try {
                const liff = await ensureLiff(LIFF_ID);
                const result = await liff.scanCode();
                if (!result || !result.value) { alert('未掃到有效 QR 碼'); return; }

                const v = result.value;
                const url = /^https?:\/\//i.test(v)
                  ? v
                  : `${location.origin}/Customer/Wallet/Start?mode=gift&token=${encodeURIComponent(v)}&liffId=${encodeURIComponent(LIFF_ID)}`;
                location.href = url;
              } catch {
                alert('掃描失敗，請用 LINE APP 操作');
              }
            });
          });
        })();
    </script>
}

