@model TeaTimeDemo.Models.ViewModels.WalletViewModel

@{
    ViewData["Title"] = "我的錢包";
    var token = Context.Request.Query["token"].ToString();
}

@* <div id="tokenBar" style="position:fixed;top:0;right:0;background:#ffd;padding:6px 12px;z-index:9999;font-size:1.2rem">
    <b>【錢包首頁】</b>token=<span id="showToken" style="color:#c00;">@token</span>
</div> *@

@section Styles {
    <link rel="stylesheet" href="~/css/wallet.css" asp-append-version="true" />
    <!-- DataTables CSS -->
    <link rel="stylesheet" href="~/lib/DataTables/datatables.min.css" asp-append-version="true" />
}

<div class="wallet-header">
    <!-- 1.1 導航列 -->
    <div class="d-flex justify-content-between align-items-center p-3">
        <a asp-area="Customer" asp-controller="Home" asp-action="Index" class="back-btn">
            <i class="bi bi-arrow-left fs-4"></i>
        </a>
        <div class="d-flex align-items-center">
            <!-- 放大鏡觸發搜尋 -->
            <i class="bi bi-search fs-4 search-btn me-2" style="cursor:pointer"></i>
            <!-- 自訂搜尋輸入框，預設隱藏 -->
            <input id="walletSearch" type="search"
                   class="form-control form-control-sm ms-2 d-none"
                   placeholder="搜尋..."
                   style="width:150px;" />
        </div>
    </div>

    <!-- 換算數量 -->
    <div class="convert-info text-white">
        <div class="title-row">
            <div class="fw-semibold">善時點數</div>
            <i class="bi bi-coin fs-3 text-white mx-1"></i>
            <div class="h3 mb-0">@Model.ConvertQuantity</div>
        </div>
        <small>換算數量</small>
    </div>

    <!-- 三功能按鈕卡片 -->
    <div class="wallet-card">
        <div class="d-flex justify-content-around mt-3">
            <a asp-action="ReturnList" class="feedback-btn text-center text-secondary text-decoration-none">
                <img src="~/images/返還.png" alt="返還" class="btn-icon" />
                <small>返還</small>
            </a>
            <a asp-action="ExchangeList" class="feedback-btn text-center text-secondary text-decoration-none">
                <img src="~/images/兌換.png" alt="兌換" class="btn-icon" />
                <small>兌換</small>
            </a>
            <a asp-action="TransferList" class="feedback-btn text-center text-secondary text-decoration-none">
                <img src="~/images/轉讓.png" alt="轉讓" class="btn-icon" />
                <small>轉讓</small>
            </a>
        </div>
    </div>
</div>

<div class="sort-wrap d-flex justify-content-center align-items-center mb-3">
    <i class="bi bi-arrow-down-up fs-5 text-secondary me-2"></i>
    <span class="fw-semibold me-2">排序依據</span>
    <select class="form-select form-select-sm w-auto">
        <option value="quantity" selected>擁有數量</option>
        <option value="name">名稱</option>
    </select>
</div>

<!-- 5. 明細清單：響應式 table -->
<div class="container mt-5 pt-5">
    <div class="table-responsive">
        <table id="walletTable" class="table table-striped table-bordered w-100">
            <thead class="table-light">
                <tr>
                    <!-- 第一欄改 40px -->
                    <th style="width:10px;">種類</th>
                    <th>名稱</th>
                    <th>擁有數量</th>
                </tr>
            </thead>
            <tbody>
                @{
                    var idx = 1;
                    foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>@idx</td>
                            <td>
                                <img src="~/images/@(item.Name).png"
                                     alt="@item.Name"
                                     class="table-icon" />
                                @item.Name
                            </td>
                            <td>@item.Quantity</td>
                        </tr>
                        idx++;
                    }
                }
            </tbody>
        </table>
    </div>
</div>



@section Scripts {

    <script>
        // --------- token自動導流機制 ---------
        window.onload = function() {
            const urlParams = new URLSearchParams(window.location.search);
            let token = urlParams.get('token');
            // 只要網址有 token 但現在不是在 Claim 頁面，就自動跳轉！
            if (token && !window.location.pathname.toLowerCase().includes("claim")) {
                window.location.href = `/Customer/Wallet/Claim?token=${encodeURIComponent(token)}`;
            }
        }
        // --------- end token自動導流 ---------
    </script>xqxsj


    <!-- jQuery (確保先載入) -->
    <script src="~/lib/jquery/dist/jquery.min.js" asp-append-version="true"></script>
    <!-- DataTables JS -->
    <script src="~/lib/DataTables/datatables.min.js" asp-append-version="true"></script>
    <script>
        $(function() {
            // 主錢包表
            var table = $('#walletTable').DataTable({
                dom: 'rtip',
                paging:   true,
                pageLength: 5,
                ordering: true,
                searching: true,    // 啟用搜尋
                info:     false,
                lengthChange: false
            });
            // 隱藏預設搜尋框
            $('.dataTables_filter').hide();

            // 放大鏡點擊，切換顯示自訂搜尋輸入框
            $('.search-btn').on('click', function() {
                var $inp = $('#walletSearch');
                $inp.toggleClass('d-none');
                if (!$inp.hasClass('d-none')) {
                    $inp.focus();
                } else {
                    // 清空搜尋並重繪
                    $inp.val('');
                    table.search('').draw();
                }
            });

            // 自訂搜尋同步到 DataTables
            $('#walletSearch').on('keyup', function() {
                table.search(this.value).draw();
            });

          
        });
    </script>
}
