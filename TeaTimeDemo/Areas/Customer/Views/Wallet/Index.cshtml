@model TeaTimeDemo.Models.ViewModels.WalletViewModel

@{
    ViewData["Title"] = "我的錢包";
}

@section Styles {
    <link rel="stylesheet" href="~/css/wallet.css" asp-append-version="true" />
    <!-- DataTables CSS -->
    <link rel="stylesheet" href="~/lib/DataTables/datatables.min.css" asp-append-version="true" />
}

<div class="wallet-header">
    <!-- 1.1 導航列 -->
    <div class="d-flex justify-content-between align-items-center p-3">
        <a asp-area="Customer" asp-controller="Home" asp-action="Index" class="back-btn">
            <i class="bi bi-arrow-left fs-4"></i>
        </a>
        <div class="d-flex align-items-center">
            <!-- 放大鏡觸發搜尋 -->
            <i class="bi bi-search fs-4 search-btn me-2" style="cursor:pointer"></i>
            <!-- 自訂搜尋輸入框，預設隱藏 -->
            <input id="walletSearch" type="search"
                   class="form-control form-control-sm ms-2 d-none"
                   placeholder="搜尋..."
                   style="width:150px;" />
        </div>
    </div>

    <!-- 換算數量 -->
    <div class="convert-info text-white">
        <div class="title-row">
            <div class="fw-semibold">善時點數</div>
            <i class="bi bi-coin fs-3 text-white mx-1"></i>
            <div class="h3 mb-0">@Model.ConvertQuantity</div>
        </div>
        <small>換算數量</small>
    </div>

    <!-- 三功能按鈕卡片 -->
    <div class="wallet-card">
        <div class="d-flex justify-content-around mt-3">
            <a asp-action="Index" class="feedback-btn text-center text-secondary text-decoration-none">
                <img src="~/images/返還.png" alt="返還" class="btn-icon" />
                <small>返還</small>
            </a>
            <a asp-action="Index" class="feedback-btn text-center text-secondary text-decoration-none">
                <img src="~/images/兌換.png" alt="兌換" class="btn-icon" />
                <small>兌換</small>
            </a>
            <a asp-action="Index" class="feedback-btn text-center text-secondary text-decoration-none">
                <img src="~/images/轉讓.png" alt="轉讓" class="btn-icon" />
                <small>轉讓</small>
            </a>
        </div>
    </div>
</div>

<div class="sort-wrap d-flex justify-content-center align-items-center mb-3">
    <i class="bi bi-arrow-down-up fs-5 text-secondary me-2"></i>
    <span class="fw-semibold me-2">排序依據</span>
    <select class="form-select form-select-sm w-auto">
        <option value="quantity" selected>擁有數量</option>
        <option value="name">名稱</option>
    </select>
</div>

<!-- 5. 明細清單：響應式 table -->
<div class="container mt-5 pt-5">
    <div class="table-responsive">
        <table id="walletTable" class="table table-striped table-bordered w-100">
            <thead class="table-light">
                <tr>
                    <!-- 第一欄改 40px -->
                    <th style="width:10px;">種類</th>
                    <th>名稱</th>
                    <th>擁有數量</th>
                </tr>
            </thead>
            <tbody>
                @{
                    var idx = 1;
                    foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>@idx</td>
                            <td>
                                <img src="~/images/@(item.Name).png"
                                     alt="@item.Name"
                                     class="table-icon" />
                                @item.Name
                            </td>
                            <td>@item.Quantity</td>
                        </tr>
                        idx++;
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- 新增：異動紀錄明細表（交易紀錄） -->
<div class="container mt-4">
    <h5>異動紀錄</h5>
    <div class="table-responsive">
        <table id="logTable" class="table table-sm table-bordered w-100">
            <thead class="table-light">
                <tr>
                    <th>時間</th>
                    <th>幣種</th>
                    <th>異動數量</th>
                    <th>異動後餘額</th>
                    <th>動作</th>
                    <th>備註</th>
                </tr>
            </thead>
            <tbody>
                @* 建議Model裡有Logs：List<UserCurrencyLogVM>，UserCurrencyLogVM欄位如下
                   - CreatedAt：時間
                   - CurrencyTypeName：幣種名稱
                   - Quantity：異動數量
                   - BalanceAfter：異動後餘額
                   - Action：動作描述
                   - Memo：備註 *@
                @if (Model.Logs != null)
                {
                    foreach (var log in Model.Logs)
                    {
                        <tr>
                            <td>@log.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                            <td>@log.CurrencyTypeName</td>
                            <td>@log.Quantity</td>
                            <td>@log.BalanceAfter</td>
                            <td>@log.Action</td>
                            <td>@log.Memo</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center">暫無異動紀錄</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <!-- jQuery (確保先載入) -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <!-- DataTables JS -->
    <script src="~/lib/DataTables/datatables.min.js"></script>
    <script>
        $(function() {
            // 主錢包表
            var table = $('#walletTable').DataTable({
                dom: 'rtip',
                paging:   true,
                pageLength: 5,
                ordering: true,
                searching: true,    // 啟用搜尋
                info:     false,
                lengthChange: false
            });
            // 隱藏預設搜尋框
            $('.dataTables_filter').hide();

            // 放大鏡點擊，切換顯示自訂搜尋輸入框
            $('.search-btn').on('click', function() {
                var $inp = $('#walletSearch');
                $inp.toggleClass('d-none');
                if (!$inp.hasClass('d-none')) {
                    $inp.focus();
                } else {
                    // 清空搜尋並重繪
                    $inp.val('');
                    table.search('').draw();
                }
            });

            // 自訂搜尋同步到 DataTables
            $('#walletSearch').on('keyup', function() {
                table.search(this.value).draw();
            });

            // 異動紀錄表，不開啟搜尋和排序
            $('#logTable').DataTable({
                dom: 'rtip',
                paging: true,
                pageLength: 10,
                ordering: false,
                searching: false,
                info: false,
                lengthChange: false
            });
        });
    </script>
}
