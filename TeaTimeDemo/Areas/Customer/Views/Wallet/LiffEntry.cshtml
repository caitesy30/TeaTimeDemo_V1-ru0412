@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>處理回傳參數中</title>
</head>
<body style="margin:0;font-family:system-ui,Segoe UI,Microsoft JhengHei,Arial">
    <script>
        class LiffReturnBridge {
            static parseQuery() {
                const p = new URLSearchParams(location.search);
                return {
                    mode: p.get('mode') || '',
                    token: p.get('token') || '',
                    // 你需要的其他參數也可一起帶
                };
            }

            static saveToStorage({mode, token}) {
                // ⚠️ 若 token 敏感，建議改方案C，這裡僅示範
                localStorage.setItem('wallet.flow.mode', mode);
                localStorage.setItem('wallet.flow.token', token);
            }

            static goFinal({mode, token}) {
                // 你的最終頁（例如點數轉讓頁），把參數再帶過去或讓該頁從 storage 取
                const url = `/Customer/Wallet/Transfer?mode=${encodeURIComponent(mode)}&token=${encodeURIComponent(token)}`;
                window.location.replace(url);
            }

            static run() {
                const q = this.parseQuery();
                this.saveToStorage(q);
                this.goFinal(q);
            }
        }
        LiffReturnBridge.run();
    </script>
</body>
</html>
