@{
    Layout = null; // 不用主版面
}
<script src="https://static.line-scdn.net/liff/2.22/sdk.js"></script>

<div id="tokenBar" style="position:fixed;top:0;right:0;background:#ffd;padding:6px 12px;z-index:9999;font-size:1.2rem">
    <b>【LiffEntry頁】</b>token=<span id="showToken" style="color:#c00;"></span>
</div>
<script>
    // ⭐ 一進來先存token！
    (function() {
        const urlParams = new URLSearchParams(window.location.search);
        let token = urlParams.get('token');
        if (token) {
            try { localStorage.setItem('claimToken', token); } catch (e) {}
        }
    })();

    // ======= 原本自動跳轉邏輯 =======
    const urlParams = new URLSearchParams(window.location.search);
    const token = urlParams.get('token');
    const mode = urlParams.get('mode');
    alert('【LiffEntry】啟動, mode=' + mode + ', token=' + token);

    // 右上顯示 token
    document.getElementById('showToken').innerText = token || "(無)";

    // 自動跳轉
    if (mode === 'claim' && token) {
        alert('準備導向 Claim 頁！');
        window.location.href = `/Customer/Wallet/Claim?token=${encodeURIComponent(token)}`;
    } else {
        alert('準備導向 Wallet 頁');
        window.location.href = `/Customer/Wallet?token=${encodeURIComponent(token)}`;
    }
</script>
