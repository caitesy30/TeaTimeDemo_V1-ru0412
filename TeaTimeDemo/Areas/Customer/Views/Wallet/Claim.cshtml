@model TeaTimeDemo.Models.PendingInvite
<form id="claimForm" method="post">
    <input type="hidden" name="token" value="@Model.Token" />
    <input type="hidden" name="lineUserId" id="lineUserId" value="" />
    <button type="submit">領取</button>
</form>

@section Scripts {
    <script src="https://static.line-scdn.net/liff/edge/2.1/sdk.js"></script>
    <script>
        liff.init({ liffId: "2007537903-5B6y1N70" }).then(() => {
            return liff.getProfile();
        }).then(profile => {
            $('#lineUserId').val(profile.userId);
        });
        $('#claimForm').on('submit', function(e) {
            if (!$('#lineUserId').val()) {
                alert('請用LINE開啟');
                e.preventDefault();
            }
        });
    </script>
}
