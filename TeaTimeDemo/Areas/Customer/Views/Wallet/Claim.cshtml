@{
    ViewData["Title"] = "LINE 領取";
    // 你的 LIFF ID（若未來要更動，可只改這裡）
    var liffId = "2007537903-r3pknwbl";
}
<div id="claimResult" class="text-center mt-5" style="font-size:2rem;font-weight:bold;">
    正在前往領取頁面，請稍候…
</div>

<script>
    (function () {
      // 如果網址含 token，就直接導去 Start（後端會處理 rid → LiffReturn → 入帳）
      const p = new URLSearchParams(location.search);
      const token = p.get('token');

      if (token) {
        const liffId = "@liffId";
        const url = `/Customer/Wallet/Start?mode=gift&token=${encodeURIComponent(token)}&liffId=${encodeURIComponent(liffId)}`;
        // 用 replace 避免使用者「上一頁」又回到中繼頁
        location.replace(url);
      } else {
        document.getElementById('claimResult').innerText = "token 遺失，請重新點擊分享連結";
      }
    })();
</script>
