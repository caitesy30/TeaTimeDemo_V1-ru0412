@{
    ViewData["Title"] = "LINE 領取";
}
<div id="claimResult" class="text-center mt-5" style="font-size:2rem;font-weight:bold;"></div>

<!-- 引入 LIFF SDK -->
<script src="https://static.line-scdn.net/liff/edge/2.1/sdk.js"></script>
<script>
    const liffId = "2007537903-r3pknwbl"; // 你的LIFF_ID

    document.getElementById('claimResult').innerText = "正在驗證身份，請稍候...";

    (async function () {
        try {
            // 初始化 LIFF
            await liff.init({ liffId });
            if (!liff.isLoggedIn()) {
                liff.login();
                return;
            }
            // 取得 LINE 使用者資料
            const profile = await liff.getProfile();
            const lineUserId = profile.userId;
            // 呼叫後端API領取點數
            fetch('/Customer/Wallet/ClaimByUserId', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ lineUserId })
            })
            .then(res => res.text())
            .then(msg => {
                document.getElementById('claimResult').innerText = msg;
            })
            .catch(err => {
                document.getElementById('claimResult').innerText = "發生錯誤：" + err;
            });
        } catch (err) {
            document.getElementById('claimResult').innerText = "LIFF初始化失敗：" + (err.message || err);
        }
    })();
</script>
