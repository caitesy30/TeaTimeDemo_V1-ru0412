@* LiffAuthEntyController的index *@
@{
    Layout = null;
}
@{
    ViewData["Title"] = "LIFF 認證入口";
    ViewBag.Redirect = Url.Action("Index", "Wallet", new { area = "Customer" });
}
<script>alert('【LiffAuthEntry 頁】即將導向 ' + "@ViewBag.Redirect");</script>

<script src="https://static.line-scdn.net/liff/edge/2.1/sdk.js"></script>
<script>
    liff.init({ liffId: "2007537903-r3pknwbl" })
        .then(() => {
            if (!liff.isLoggedIn()) liff.login();
            else {
                // 登入完自動導向
                window.location.href = "@ViewBag.Redirect";
            }
        });
</script>
