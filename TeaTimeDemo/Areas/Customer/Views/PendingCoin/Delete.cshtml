@model TeaTimeDemo.Models.PendingCoin
@{
    ViewData["Title"] = "刪除待領幣";
    Layout = "_Layout";
}
<div class="container mt-4" style="max-width:480px">
    <h3 class="mb-4 text-danger"><i class="bi bi-exclamation-triangle"></i> 刪除待領幣</h3>
    <div class="alert alert-warning">
        <strong>確定要刪除這筆待領幣？</strong><br>
        刪除後無法復原，請再次確認。
    </div>
    <dl class="row">
        <dt class="col-5">LINE UserId</dt>
        <dd class="col-7">@Model.LineUserId</dd>
        <dt class="col-5">幣種ID</dt>
        <dd class="col-7">@Model.CurrencyTypeId</dd>
        <dt class="col-5">數量</dt>
        <dd class="col-7">@Model.Quantity</dd>
    </dl>
    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger w-100">確定刪除</button>
        <a asp-action="Index" class="btn btn-link w-100 mt-2">取消</a>
    </form>
</div>
