@model TeaTimeDemo.Models.PendingCoin
@{
    ViewData["Title"] = "編輯待領幣";
    Layout = "_Layout";
}
<div class="container mt-4" style="max-width:480px">
    <h3 class="mb-4"><i class="bi bi-pencil"></i> 編輯待領幣</h3>
    <form asp-action="Edit" method="post">
        <input asp-for="Id" type="hidden" />
        <div class="mb-3">
            <label class="form-label">LINE UserId</label>
            <input asp-for="LineUserId" class="form-control" required />
        </div>
        <div class="mb-3">
            <label class="form-label">幣種ID</label>
            <input asp-for="CurrencyTypeId" class="form-control" required />
        </div>
        <div class="mb-3">
            <label class="form-label">數量</label>
            <input asp-for="Quantity" class="form-control" required min="1" />
        </div>
        <div class="mb-3">
            <label class="form-label">來源會員</label>
            <input asp-for="FromUserId" class="form-control" />
        </div>
        <div class="mb-3">
            <label class="form-label">備註</label>
            <input asp-for="Memo" class="form-control" maxlength="100" />
        </div>
        <button type="submit" class="btn btn-primary w-100">儲存修改</button>
        <a asp-action="Index" class="btn btn-link w-100 mt-2">返回管理</a>
    </form>
</div>
